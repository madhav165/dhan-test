SESSION_SECRET=change-this-to-a-long-random-string
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/dhan?sslmode=disable

# Go service
GO_URL=http://localhost:8080
INTERNAL_SECRET=change-this-to-a-long-random-string
ENCRYPTION_KEY=change-this-to-a-64-char-hex-string

# MinIO (local) — use S3 credentials when deploying
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-to-a-long-random-string
MINIO_BUCKET=dhan

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_AUTH_URL=https://auth.dhan.co

# Your app credentials (developer only — register at web.dhan.co)
DHAN_APP_ID=your_app_id
DHAN_APP_SECRET=your_app_secret

# Callback URL registered with Dhan
DHAN_CALLBACK_URL=http://localhost:5173/auth/dhan/callback

# Per-user credentials (set after OAuth flow, not hardcoded)
DHAN_CLIENT_ID=your_client_id
DHAN_ACCESS_TOKEN=your_access_token
